<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ru.xitrix.Moonlight</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Moonlight-Switch</name>
  <summary>Stream games from a Sunshine or GameStream host</summary>
  <description>
    <p>
      Moonlight-Switch is a controller-friendly Moonlight game-streaming client.
      It supports keyboard, mouse, gamepad, and hardware-accelerated video
      decoding on compatible Linux systems.
    </p>
  </description>
  <launchable type="desktop-id">ru.xitrix.Moonlight.desktop</launchable>
  <provides>
    <binary>Moonlight</binary>
    <binary>moonlight-switch</binary>
  </provides>
  <url type="homepage">https://github.com/XITRIX/Moonlight-Switch</url>
  <url type="bugtracker">https://github.com/XITRIX/Moonlight-Switch/issues</url>
  <developer_name>XITRIX</developer_name>
  <content_rating type="oars-1.1"/>
</component>
