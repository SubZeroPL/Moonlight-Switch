Name:           moonlight-switch
Version:        @RPM_VERSION@
Release:        1%{?dist}
Summary:        Controller-friendly Moonlight game-streaming client
License:        GPL-3.0-or-later
URL:            https://github.com/XITRIX/Moonlight-Switch
Source0:        moonlight-switch-bundle.tar.gz
BuildArch:      @RPM_ARCH@
Requires:       glibc, libglvnd-egl, libglvnd-gles, libva, libdrm

%description
Moonlight-Switch streams games from a Sunshine or GameStream host and
supports keyboard, mouse, gamepad, and hardware-accelerated video decoding.

%prep

%build

%install
mkdir -p %{buildroot}/opt/moonlight-switch
tar -xzf %{SOURCE0} -C %{buildroot}/opt/moonlight-switch

mkdir -p %{buildroot}%{_bindir}
ln -s /opt/moonlight-switch/AppRun %{buildroot}%{_bindir}/moonlight-switch

install -Dpm0644 \
    %{buildroot}/opt/moonlight-switch/usr/share/applications/ru.xitrix.Moonlight.desktop \
    %{buildroot}%{_datadir}/applications/ru.xitrix.Moonlight.desktop
install -Dpm0644 \
    %{buildroot}/opt/moonlight-switch/usr/share/icons/hicolor/96x96/apps/ru.xitrix.Moonlight.png \
    %{buildroot}%{_datadir}/icons/hicolor/96x96/apps/ru.xitrix.Moonlight.png
install -Dpm0644 \
    %{buildroot}/opt/moonlight-switch/usr/share/metainfo/ru.xitrix.Moonlight.metainfo.xml \
    %{buildroot}%{_datadir}/metainfo/ru.xitrix.Moonlight.metainfo.xml

%files
/opt/moonlight-switch
%{_bindir}/moonlight-switch
%{_datadir}/applications/ru.xitrix.Moonlight.desktop
%{_datadir}/icons/hicolor/96x96/apps/ru.xitrix.Moonlight.png
%{_datadir}/metainfo/ru.xitrix.Moonlight.metainfo.xml

%changelog
* Sun Jul 26 2026 XITRIX - @RPM_VERSION@-1
- Automated portable Linux package
